{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",

		"lib": ["ES2022", "DOM"],
		"types": ["node"],

		"outDir": "lib",

		"strict": true,
		"noImplicitReturns": true,
		"isolatedModules": true,
		"importHelpers": true,

		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,

		"declaration": true,
		"declarationMap": true,

		"rootDir": "src",
		"skipLibCheck": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "lib"]
}
