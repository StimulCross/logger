{
	"compilerOptions": {
		"module": "node16",
		"moduleResolution": "node16",
		"target": "ES2022",
		"lib": ["ES2022"],
		"outDir": "lib",
		"rootDir": "src",
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitReturns": true,
		"strict": true,
		"importHelpers": true,
		"isolatedModules": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "lib"]
}
